<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>
    body {
      font-family: Georgia, "Times New Roman", serif;
      max-width: 780px;
      margin: 0 auto;
      padding: 2.4em 1.6em;
      line-height: 1.7;
      color: #111;
    }
    h1 {
      font-size: 2.4em;
      text-align: center;
      margin-bottom: 0.2em;
      letter-spacing: -0.02em;
    }
    .subtitle {
      text-align: center;
      color: #777;
      font-size: 0.95em;
      font-style: italic;
      margin-bottom: 3em;
      border-bottom: 1px solid #ccc;
      padding-bottom: 1.5em;
    }
    h2 {
      font-size: 1.5em;
      margin-top: 2em;
      border-bottom: 1px solid #ddd;
      padding-bottom: 0.2em;
    }
    h3 { font-size: 1.2em; margin-top: 1.6em; }
    pre, code {
      font-family: "Courier New", monospace;
      font-size: 0.88em;
      background: #fafafa;
    }
    pre { padding: 1em; border-left: 2px solid #888; overflow-x: auto; }
    blockquote {
      border-left: 3px solid #999;
      margin: 1.5em 0;
      padding: 0.2em 1.2em;
      color: #444;
      font-style: italic;
    }
    table { border-collapse: collapse; width: 100%; margin: 1.5em 0; }
    th, td { border: 1px solid #ccc; padding: 0.6em 0.8em; }
    th { background: #f0f0f0; text-align: left; }
    .footer {
      margin-top: 4em;
      padding-top: 1.5em;
      border-top: 1px solid #ccc;
      text-align: center;
      color: #999;
      font-size: 0.85em;
    }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>
  {% if metadata.subtitle or metadata.author %}
  <p class="subtitle">
    {% if metadata.subtitle %}{{ metadata.subtitle }}{% endif %}
    {% if metadata.subtitle and metadata.author %} — {% endif %}
    {% if metadata.author %}{{ metadata.author }}{% endif %}
    {% if metadata.date %} · {{ metadata.date }}{% endif %}
  </p>
  {% endif %}
  {{ body | safe }}
  <div class="footer">Report generated {{ generated_at }} · Hermes Documents</div>
</body>
</html>
